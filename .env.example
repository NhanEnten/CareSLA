# CareSLA — Biến môi trường
# Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit .env vào Git.

# ── Mạng ──
NETWORK=localhost
# NETWORK=sepolia
RPC_URL=http://127.0.0.1:8545
# RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# ── Gateway ──
GATEWAY_PRIVATE_KEY=0x...khóa_ví_gateway_testnet...

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Telegram chat ID cho từng vai trò (lấy bằng @userinfobot)
TELEGRAM_CHAT_PRIMARY=
TELEGRAM_CHAT_BACKUP=
TELEGRAM_CHAT_FAMILY=
TELEGRAM_CHAT_CENTER=

# ── Contract ──
# Tự động đọc từ deployments/<NETWORK>.json, nhưng có thể ghi đè ở đây
# CONTRACT_ADDRESS=0x...

# ── MQTT ──
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# ── Thiết bị đã đăng ký (fallback khi không đọc được chain) ──
REGISTERED_DEVICES=0xdevice1,0xdevice2
