# CareSLA — Biến môi trường (danh sách thống nhất, IC-15)
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env vào Git.
# Chỉ dùng ví TESTNET. Mỗi vai trò một ví riêng.

# ── Mạng ──
# localhost: Hardhat node tại http://127.0.0.1:8545 (cố định, không cần biến)
# sepolia:   dùng SEPOLIA_RPC_URL bên dưới
NETWORK=localhost
SEPOLIA_RPC_URL=

# ── Khóa ví (P2: deploy + keeper, P5: gateway) ──
DEPLOYER_PRIVATE_KEY=
GATEWAY_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=

# ── Etherscan (P2: verify contract trên Sepolia) ──
ETHERSCAN_API_KEY=

# ── Contract ──
# Địa chỉ tự đọc từ deployments/<NETWORK>.json; chỉ đặt khi muốn ghi đè
# CONTRACT_ADDRESS=0x...
# planId dùng cho demo (demo_setup.js in ra)
PLAN_ID=1

# ── MQTT (Mosquitto trên laptop demo) ──
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=
# Chat ID cho từng vai trò (lấy bằng @userinfobot)
TELEGRAM_CHAT_PRIMARY=
TELEGRAM_CHAT_BACKUP=
TELEGRAM_CHAT_FAMILY=
TELEGRAM_CHAT_PROVIDER=

# ── Thiết bị đã đăng ký (gateway dùng để lọc rác khi không đọc được chain) ──
REGISTERED_DEVICES=

# demo_setup: thiết bị lấy từ REGISTERED_DEVICES nếu chỉ có 1 địa chỉ,
# hoặc npx hardhat demo-setup --network localhost --device 0x...
# Ví demo Sepolia truyền qua tham số riêng của task; xem README, không thêm tên biến chung.
