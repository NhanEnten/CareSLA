{
  "name": "caresla-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "CareSLA - kiem thu, deploy va demo cua P2",
  "engines": { "node": ">=22" },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:required": "node scripts/test_required.js",
    "test:gas": "node scripts/test_required.js --gas",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "setup:local": "hardhat demo-setup --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "setup:sepolia": "hardhat demo-setup --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.14.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "solc": "0.8.24"
  }
}
