diff --git a/tensorflow/lite/micro/kernels/space_to_batch_nd.cc b/tensorflow/lite/micro/kernels/space_to_batch_nd.cc
index f8df149..bcf5748 100644
--- a/tensorflow/lite/micro/kernels/space_to_batch_nd.cc
+++ b/tensorflow/lite/micro/kernels/space_to_batch_nd.cc
@@ -65,0 +66,6 @@ TfLiteStatus SpaceToBatchNDPrepare(TfLiteContext* context, TfLiteNode* node) {
+  // CareSLA: padding phai bieu dien so 0 that trong mien luong tu INT8.
+  // AllocatePersistentBuffer khong khoi tao SpaceToBatchParams.
+  TF_LITE_ENSURE(context, node->user_data != nullptr);
